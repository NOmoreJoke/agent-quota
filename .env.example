# Copy this template to `.env.local` (ignored by Git via `.env.*` in `.gitignore`).
# Never commit real certificates, OAuth client secrets, or personal credentials.

# Apple code signing (10-char Team ID & 40-hex certificate SHA-1 from `security find-identity -v -p codesigning`)
AQ_CODESIGN_IDENTITY=
AQ_CODESIGN_TEAM_ID=
# Optional: set to 1 to force Hardened Runtime with Apple Development; auto-enabled for Developer ID Application
# AQ_CODESIGN_HARDENED_RUNTIME=

# Pinned standalone Rust toolchain directory (see docs/INSTALLATION.md / docs/VERIFY.md)
AQ_RUST_BIN=

# Optional build-time default Google Antigravity OAuth Client (never stored in Git)
AQ_ANTIGRAVITY_OAUTH_CLIENT_ID=
AQ_ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Apple Notary Service keychain profile name (`xcrun notarytool store-credentials <profile>`)
AQ_NOTARY_KEYCHAIN_PROFILE=
