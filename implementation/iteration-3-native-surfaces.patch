+fn call_internal(
+    state: &State<'_, HostState>,
+    command_id: &str,
+    request: Value,
+) -> Result<Value, SupervisorError> {
+    let mut guard = state
+        .sidecar
+        .lock()
+        .map_err(|_| SupervisorError::Protocol)?;
+    let sidecar = guard.as_mut().ok_or(SupervisorError::Spawn)?;
