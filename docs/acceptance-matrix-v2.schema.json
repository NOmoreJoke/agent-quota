{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-quota.invalid/schemas/acceptance-matrix-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decided_at",
    "completion_rule",
    "allowed_statuses",
    "scope_summary",
    "formal_release_gates",
    "formal_release_gate_allowed_statuses",
    "products",
    "disabled_information_card_policy"
  ],
  "properties": {
    "schema": { "const": "agent-quota-acceptance-matrix-v2" },
    "decided_at": { "type": "string", "format": "date" },
    "completion_rule": { "type": "string", "minLength": 1 },
    "allowed_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scope_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_count",
        "product_card_count",
        "target_actionable_candidate_count",
        "current_creatable_count",
        "implementation_blocked_candidate_count",
        "disabled_information_card_count"
      ],
      "properties": {
        "brand_count": { "type": "integer", "minimum": 1 },
        "product_card_count": { "type": "integer", "minimum": 1 },
        "target_actionable_candidate_count": { "type": "integer", "minimum": 0 },
        "current_creatable_count": { "type": "integer", "minimum": 0 },
        "implementation_blocked_candidate_count": { "type": "integer", "minimum": 0 },
        "disabled_information_card_count": { "type": "integer", "minimum": 0 }
      }
    },
    "formal_release_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/formalReleaseGate" }
    },
    "formal_release_gate_allowed_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product" }
    },
    "disabled_information_card_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creatable",
        "credential_collection",
        "provider_request",
        "web_scraping",
        "release_denominator"
      ],
      "properties": {
        "creatable": { "const": false },
        "credential_collection": { "const": false },
        "provider_request": { "const": false },
        "web_scraping": { "const": false },
        "release_denominator": { "const": false }
      }
    }
  },
  "$defs": {
    "formalReleaseGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "required", "status", "commit_binding", "evidence"],
      "properties": {
        "gate_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "required": { "type": "boolean" },
        "status": { "type": "string", "minLength": 1 },
        "commit_binding": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          ]
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "claimed",
        "release_denominator",
        "status",
        "official_evidence"
      ],
      "properties": {
        "capability_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "claimed": { "type": "boolean" },
        "release_denominator": { "type": "boolean" },
        "status": { "type": "string", "minLength": 1 },
        "official_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https://" }
        },
        "promotion_gate": { "type": "string", "minLength": 1 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "brand",
        "display_name",
        "region",
        "adapter_id",
        "target_actionable_candidate",
        "current_creatable",
        "evidence_tier",
        "release_status",
        "capabilities"
      ],
      "properties": {
        "product_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "brand": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "adapter_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          ]
        },
        "target_actionable_candidate": { "type": "boolean" },
        "current_creatable": { "type": "boolean" },
        "evidence_tier": { "type": "string", "minLength": 1 },
        "release_status": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    }
  }
}
